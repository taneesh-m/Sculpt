# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Google OAuth is configured in the Supabase dashboard (Authentication ->
# Providers -> Google), not read directly by app code. Create the OAuth
# client at https://console.cloud.google.com/apis/credentials and paste its
# client ID/secret into the Supabase provider settings.

# OpenAI (chat + tool-calling agent)
OPENAI_API_KEY=your_openai_api_key

# USDA FoodData Central (real nutrition lookups) - free key at
# https://fdc.nal.usda.gov/api-key-signup
USDA_API_KEY=your_usda_api_key

# Service-role key: only used by the offline eval script (eval/run.ts),
# never by the app's Route Handlers. Project Settings -> API -> service_role.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
